import sys


def calc_price_per_100ml(ml_per_bottle: float, bottle_count: int, price: float) -> float:
    if ml_per_bottle <= 0 or bottle_count <= 0 or price < 0:
        raise ValueError("容量と本数は0より大きい値、値段は0以上の数値を指定してください")
    total_ml = ml_per_bottle * bottle_count
    return (price / total_ml) * 100


def main() -> int:
    has_error = False

    for line_no, raw_line in enumerate(sys.stdin, start=1):
        line = raw_line.strip()
        if not line:
            print(f"{line_no}行目: 空行です", file=sys.stderr)
            has_error = True
            continue

        parts = line.split()
        if len(parts) != 3:
            print(f"{line_no}行目: 容量・本数・値段の3つを指定してください", file=sys.stderr)
            has_error = True
            continue

        try:
            ml_per_bottle = float(parts[0])
            bottle_count = int(parts[1])
            price = float(parts[2])
            per_100ml = calc_price_per_100ml(ml_per_bottle, bottle_count, price)
            print(f"{per_100ml:.2f}")
        except ValueError as e:
            print(f"{line_no}行目: {e}", file=sys.stderr)
            has_error = True

    return 1 if has_error else 0


if __name__ == "__main__":
    sys.exit(main())