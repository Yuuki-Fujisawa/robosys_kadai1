def calc_price_per_ml():
    print("=== 1mLあたりの値段 計算ツール ===")

    while True:
        try:
            ml_per_bottle = float(input("1本あたりの容量（mL）を入力してください: "))
            bottle_count = int(input("本数を入力してください: "))
            price = float(input("合計の値段（円）を入力してください: "))

            if ml_per_bottle <= 0 or bottle_count <= 0 or price < 0:
                print("容量・本数は0より大きい値、値段は0以上の値を入力してください。\n")
                continue

            total_ml = ml_per_bottle * bottle_count
            price_per_ml = price / total_ml
            price_per_100ml = price_per_ml * 100

            print("-" * 40)
            print(f"総容量: {total_ml:,.1f} mL")
            print(f"100mLあたりの値段: {price_per_100ml:.2f} 円")
            print("-" * 40)
            break

        except ValueError:
            print("数値を正しく入力してください。\n")


if __name__ == "__main__":
    calc_price_per_ml()